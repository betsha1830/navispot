# Spotify Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3883/api/auth/callback

# Application URL
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3883

# Set to 1 when serving NaviSpot directly over HTTPS (no reverse proxy
# setting x-forwarded-proto), so auth cookies are always marked Secure.
# Leave unset for plain-HTTP LAN deployments — secure cookies are silently
# dropped by browsers over HTTP and logins appear to work but never stick.
# FORCE_SECURE_COOKIES=1

# Navidrome Configuration (optional - can configure via UI)
# NAVIDROME_URL=http://localhost:4533
# NAVIDROME_USERNAME=
# NAVIDROME_PASSWORD=
